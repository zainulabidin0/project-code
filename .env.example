# Use pooled URL for app (e.g. Supabase port 6543 with ?pgbouncer=true)
DATABASE_URL=postgresql://user:pass@host:6543/postgres?pgbouncer=true
# Direct URL for migrations only (port 5432)
DATABASE_DIRECT_URL=postgresql://user:pass@host:5432/postgres
# Optional. Leave empty or unset for local dev — uses in-memory rate limits (no Redis).
# Use a real host (e.g. Upstash) — do not keep the literal hostname "host" from templates.
REDIS_URL=
JWT_ACCESS_SECRET=change-me-64-chars-minimum-random-string-here-please
JWT_REFRESH_SECRET=change-me-different-64-chars-random-string-here-please
# Address correction + ShopAssist chat, intent, and voice (Groq)
GROQ_API_KEY=gsk_xxxxxxxxxxxx
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_xxxxxxxxxxxx
EMAIL_FROM=noreply@addressfix.dev
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Local sentiment service (uvicorn in python-service/). Default 8100. Ignored if SENTIMENT_SERVICE_URL is set.
PYTHON_SERVICE_PORT=8100
# Production (e.g. Vercel + Python on Railway/Render): public base URL of the FastAPI app, no trailing slash.
# SENTIMENT_SERVICE_URL=
# Optional: path to python executable (e.g. py -3 on Windows). Default: python (Win) or python3.
# PYTHON_PATH=
NODE_ENV=development
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# 32-byte hex for AES (Shopify Admin access token at rest). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_STOREFRONT_TOKEN=
NEXT_PUBLIC_WIDGET_URL=http://localhost:3000/widget.js
CRON_SECRET=change-me-random-cron-secret
